<mxfile host="app.diagrams.net" modified="2026-02-20T00:00:00.000Z" agent="GitHub Copilot" version="22.1.0" type="device">
  <diagram id="diagram-gnu-audit" name="gnu/audit (flow)">
    <mxGraphModel dx="1200" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Nodes -->
        <mxCell id="n_start" value="начало" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n_init" value="инициализация&#10;GUI и модулей&#10;(interface.py)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="120" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n_security" value="инициализация безопасности&#10;(понижение привилегий,&#10;списки исключений)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="235" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n_wait" value="нажата кнопка&#10;«Начать мониторинг»?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="360" width="170" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n_start_mon" value="запуск мониторинга&#10;процессов / сети / файлов&#10;(потоки + watchdog)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="510" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n_event" value="получено событие&#10;(process/file/network)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="645" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n_filter" value="фильтрация&#10;(исключения по процессам&#10;и путям)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="760" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n_log" value="логирование события&#10;в audit_log.json&#10;+ внутренние сообщения" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="875" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n_actions" value="действие пользователя?&#10;(поиск / отчёт / стоп)" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="665" y="645" width="200" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n_search" value="поиск/фильтры&#10;в журнале&#10;(по типу, PID, имени, пути)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="610" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n_report" value="генерация отчёта&#10;статистика + графики&#10;(report.py)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="760" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n_tg" value="отправка в Telegram&#10;(лог/отчёт файлом&#10;+ сообщение)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="895" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n_stop" value="нажата «Остановить»&#10;→ остановка потоков&#10;и наблюдателей" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="460" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n_end" value="конец" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="970" y="300" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="endArrow=block;html=1;orthogonalLoop=1;rounded=0;" edge="1" parent="1" source="n_start" target="n_init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;orthogonalLoop=1;rounded=0;" edge="1" parent="1" source="n_init" target="n_security">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;orthogonalLoop=1;rounded=0;" edge="1" parent="1" source="n_security" target="n_wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- wait decision -->
        <mxCell id="e_wait_no" value="нет" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_wait" target="n_wait">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="195" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_wait_yes" value="да" style="endArrow=block;html=1;orthogonalLoop=1;rounded=0;" edge="1" parent="1" source="n_wait" target="n_start_mon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" style="endArrow=block;html=1;orthogonalLoop=1;rounded=0;" edge="1" parent="1" source="n_start_mon" target="n_event">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;orthogonalLoop=1;rounded=0;" edge="1" parent="1" source="n_event" target="n_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;orthogonalLoop=1;rounded=0;" edge="1" parent="1" source="n_filter" target="n_log">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- loop: after logging, continue monitoring -->
        <mxCell id="e_loop" value="цикл" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_log" target="n_event">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="185" y="925" as="sourcePoint" />
            <mxPoint x="185" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- user actions branch -->
        <mxCell id="e_to_actions" value="UI" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_event" target="n_actions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_action_search" value="поиск" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_actions" target="n_search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_action_report" value="отчёт" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_actions" target="n_report">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_action_stop" value="стоп" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_actions" target="n_stop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_report_to_tg" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_report" target="n_tg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- back to monitoring after search/report -->
        <mxCell id="e_search_back" value="назад" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_search" target="n_actions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tg_back" value="назад" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_tg" target="n_actions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_stop_end" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="n_stop" target="n_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
