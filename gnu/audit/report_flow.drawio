        </mxCell>

        <mxCell id="r_end" value="конец&#10;(файл отчёта создан)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="290" y="970" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Detailed plots sub-flow (right side) -->
