          <mxGeometry x="325" y="340" width="170" height="110" as="geometry" />
        </mxCell>

        <mxCell id="r_fail" value="нет данных для отчёта&#10;→ завершить" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="355" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="r_stats" value="рассчитать статистику&#10;(pandas DataFrame)&#10;• total_events&#10;• период&#10;• event_types&#10;• top_processes/top_files&#10;• network_stats&#10;• activity by hour/day" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="470" width="320" height="170" as="geometry" />
        </mxCell>

        <mxCell id="r_plots" value="создать графики&#10;(create_plots)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="660" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="r_md" value="сформировать Markdown отчёт&#10;(system_report_{report_id}.md)&#10;• заголовок + дата&#10;• общая статистика&#10;• распределение типов&#10;• топ процессов/файлов (если есть)&#10;• сеть (если есть)&#10;• вставки картинок&#10;• заключение" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
